// Life RPG - Prisma schema
// See docs/mvp-spec.md ("Section 15: Data Model") for the product-level description.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GoalType {
  NUMERIC
  COMPLETION
  BINARY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum QuestType {
  ONE_TIME
  RECURRING
  DEADLINE
  MILESTONE
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
  EPIC
  LEGENDARY
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HabitFrequency {
  DAILY
  DAYS_OF_WEEK
  TIMES_PER_WEEK
  MONTHLY
}

enum XPSourceType {
  QUEST_COMPLETION
  HABIT_COMPLETION
  GOAL_COMPLETION
  ACHIEVEMENT_BONUS
  CORRECTION
}

enum AchievementRequirementType {
  LEVEL_REACHED
  STREAK_LENGTH
  QUESTS_COMPLETED
  GOALS_COMPLETED
  HABITS_COMPLETED
  SKILL_LEVEL_REACHED
  SKILL_ACTIVITY_COUNT
  GOALS_CREATED
  ATTRIBUTE_LEVEL_REACHED
}

enum AttributeKey {
  PHYSICAL
  INTELLIGENCE
  DISCIPLINE
  ENERGY
  SOCIAL
  WEALTH
  CREATIVITY
  WISDOM
}

enum NotificationType {
  HABIT_REMINDER
  QUEST_DEADLINE
  STREAK_WARNING
  LEVEL_UP
  ACHIEVEMENT_UNLOCK
  GOAL_MILESTONE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id                 String  @id @default(uuid())
  email              String  @unique
  username           String  @unique
  passwordHash       String
  avatar             String?
  hashedRefreshToken String?
  isAdmin            Boolean @default(false)

  level          Int       @default(1)
  totalXP        Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills                 Skill[]
  attributes             Attribute[]
  goals                  Goal[]
  quests                 Quest[]
  habits                 Habit[]
  habitCompletions       HabitCompletion[]
  xpTransactions         XPTransaction[]
  userAchievements       UserAchievement[]
  notifications          Notification[]
  sentFriendRequests     Friendship[]      @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]      @relation("FriendshipAddressee")

  @@map("users")
}

/// A friendship between two users, always stored as a single row regardless
/// of direction. Starts PENDING (created by the requester) and becomes
/// ACCEPTED once the addressee accepts - there is no DECLINED status, a
/// decline/cancel/unfriend is just deleting the row (see FriendsService).
/// The leaderboard's comparison group for a user is themselves plus every
/// user they have an ACCEPTED Friendship row with, in either direction.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // Only stops a duplicate row in the SAME direction - the service layer
  // additionally checks the reverse direction before creating a new request,
  // since A->B and B->A are logically the same relationship.
  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendships")
}

/// The 8 top-level character attributes (Physical, Intelligence, ...). Every
/// user gets all 8 auto-created at registration - unlike skills, attributes
/// are not opt-in. Attribute XP/level is derived by mirroring the XP a user
/// earns in any skill that belongs to it (see XpService.awardXp).
model Attribute {
  id          String       @id @default(uuid())
  userId      String
  key         AttributeKey
  name        String
  description String?
  icon        String?

  level   Int @default(1)
  totalXP Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          Skill[]
  xpTransactions  XPTransaction[]
  activityBonuses ActivityAttributeBonus[]

  @@unique([userId, key])
  @@index([userId])
  @@map("attributes")
}

/// Bonus XP a quest/habit/goal awards directly to an attribute on completion,
/// independent of any tagged skill - e.g. a workout quest giving some
/// Discipline credit for showing up, on top of whatever Strength/Physical it
/// awards via tagged skills (see QuestSkill.amount and friends). Exactly one
/// of questId/habitId/goalId is set, matching whichever activity owns this
/// bonus line. Part of "XP Bundles" - see docs/gameplay-systems.md.
model ActivityAttributeBonus {
  id          String  @id @default(uuid())
  questId     String?
  habitId     String?
  goalId      String?
  attributeId String
  amount      Int

  quest     Quest?    @relation(fields: [questId], references: [id], onDelete: Cascade)
  habit     Habit?    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([questId, attributeId])
  @@unique([habitId, attributeId])
  @@unique([goalId, attributeId])
  @@index([questId])
  @@index([habitId])
  @@index([goalId])
  @@index([attributeId])
  @@map("activity_attribute_bonuses")
}

model Skill {
  id          String  @id @default(uuid())
  userId      String
  attributeId String
  name        String
  description String?
  icon        String?
  isDefault   Boolean @default(false)

  level   Int @default(1)
  totalXP Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  questSkills    QuestSkill[]
  habitSkills    HabitSkill[]
  goalSkills     GoalSkill[]
  xpTransactions XPTransaction[]

  // Same skill name can exist under different attributes (e.g. "Focus" under
  // both Intelligence and Discipline) as distinct stats, so uniqueness is
  // scoped per-attribute rather than globally per-user.
  @@unique([userId, attributeId, name])
  @@index([userId])
  @@index([attributeId])
  @@map("skills")
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String?
  type        GoalType   @default(BINARY)
  status      GoalStatus @default(ACTIVE)

  targetValue  Float?
  currentValue Float   @default(0)
  unit         String?

  xpReward Int @default(500)

  startDate   DateTime  @default(now())
  targetDate  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests           Quest[]
  goalSkills       GoalSkill[]
  attributeBonuses ActivityAttributeBonus[]

  @@index([userId])
  @@map("goals")
}

model GoalSkill {
  id      String @id @default(uuid())
  goalId  String
  skillId String
  /// Overrides the goal's flat xpReward for this specific skill (and its
  /// attribute cascade) on completion. Null means "use the goal's xpReward",
  /// matching behavior before XP Bundles (see ActivityAttributeBonus) existed.
  amount  Int?

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([goalId, skillId])
  @@map("goal_skills")
}

model Quest {
  id          String  @id @default(uuid())
  userId      String
  goalId      String?
  title       String
  description String?

  type       QuestType       @default(ONE_TIME)
  difficulty QuestDifficulty @default(MEDIUM)
  status     QuestStatus     @default(ACTIVE)

  xpReward        Int
  deadline        DateTime?
  completedAt     DateTime?
  lastCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?                    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  questSkills      QuestSkill[]
  attributeBonuses ActivityAttributeBonus[]

  @@index([userId])
  @@index([goalId])
  @@map("quests")
}

model QuestSkill {
  id      String @id @default(uuid())
  questId String
  skillId String
  /// Overrides the quest's flat xpReward for this specific skill (and its
  /// attribute cascade) on completion. Null means "use the quest's xpReward",
  /// matching behavior before XP Bundles (see ActivityAttributeBonus) existed.
  amount  Int?

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([questId, skillId])
  @@map("quest_skills")
}

model Habit {
  id          String  @id @default(uuid())
  userId      String
  title       String
  description String?

  frequency    HabitFrequency @default(DAILY)
  daysOfWeek   Int[]          @default([])
  timesPerWeek Int?
  timeOfDay    String?

  xpReward      Int     @default(10)
  isActive      Boolean @default(true)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitSkills      HabitSkill[]
  completions      HabitCompletion[]
  attributeBonuses ActivityAttributeBonus[]

  @@index([userId])
  @@map("habits")
}

model HabitSkill {
  id      String @id @default(uuid())
  habitId String
  skillId String
  /// Overrides the habit's flat xpReward for this specific skill (and its
  /// attribute cascade) on completion. Null means "use the habit's xpReward",
  /// matching behavior before XP Bundles (see ActivityAttributeBonus) existed.
  amount  Int?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([habitId, skillId])
  @@map("habit_skills")
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  userId      String
  periodKey   String
  completedAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, periodKey])
  @@index([userId])
  @@map("habit_completions")
}

model XPTransaction {
  id          String       @id @default(uuid())
  userId      String
  skillId     String?
  attributeId String?
  amount      Int
  sourceType  XPSourceType
  sourceId    String?
  /// The source entity's display name (e.g. a quest's title), captured at write
  /// time rather than resolved later by joining on sourceId - so a ledger row's
  /// label survives the source quest/habit/goal being renamed or deleted.
  sourceName  String?
  /// Correlates every row written by a single XpService.awardXp/applyCorrection
  /// call (the character row plus each skill/attribute mirror row it cascaded
  /// into), so AnalyticsService.xpHistory can group them back into one event.
  /// Deliberately NOT createdAt: Prisma's @default(now()) is evaluated
  /// per-statement (client-side), not per-transaction, so sibling rows from one
  /// call can differ by a few milliseconds - not a safe grouping key. Nullable
  /// because rows written before this column existed have no value to backfill.
  eventId     String?
  note        String?
  createdAt   DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill?     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attribute Attribute? @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skillId])
  @@index([attributeId])
  @@index([userId, createdAt])
  @@index([eventId])
  @@map("xp_transactions")
}

model Achievement {
  id               String                     @id @default(uuid())
  key              String                     @unique
  name             String
  description      String
  icon             String?
  requirementType  AchievementRequirementType
  requirementValue Int
  skillName        String?
  attributeKey     AttributeKey?

  createdAt DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}
