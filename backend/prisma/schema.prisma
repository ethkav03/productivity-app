// Life RPG - Prisma schema
// See docs/mvp-spec.md ("Section 15: Data Model") for the product-level description.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GoalType {
  NUMERIC
  COMPLETION
  BINARY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SeasonStatus {
  ACTIVE
  COMPLETED
}

enum QuestType {
  ONE_TIME
  RECURRING
  DEADLINE
  MILESTONE
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
  EPIC
  LEGENDARY
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum QuestRequirementType {
  LEVEL_THRESHOLD
  ACTIVITY_COUNT
  ACHIEVEMENT
  QUEST_COMPLETED
  GOAL_COMPLETED
}

enum QuestCategory {
  DAILY
  WEEKLY
  LONG_TERM
  SYSTEM
}

enum HabitFrequency {
  DAILY
  DAYS_OF_WEEK
  TIMES_PER_WEEK
  MONTHLY
}

enum ChallengeType {
  DAILY
  WEEKLY
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum XPSourceType {
  QUEST_COMPLETION
  HABIT_COMPLETION
  GOAL_COMPLETION
  ACHIEVEMENT_BONUS
  CHALLENGE_COMPLETION
  MILESTONE_COMPLETION
  CORRECTION
}

enum AchievementRequirementType {
  LEVEL_REACHED
  STREAK_LENGTH
  QUESTS_COMPLETED
  GOALS_COMPLETED
  HABITS_COMPLETED
  SKILL_LEVEL_REACHED
  SKILL_ACTIVITY_COUNT
  GOALS_CREATED
  ATTRIBUTE_LEVEL_REACHED
}

enum AttributeKey {
  PHYSICAL
  INTELLIGENCE
  DISCIPLINE
  ENERGY
  SOCIAL
  WEALTH
  CREATIVITY
  WISDOM
}

enum LevelRewardType {
  TITLE
  BADGE
  STREAK_PROTECTION
  FEATURE_UNLOCK
  QUEST
}

enum NotificationType {
  HABIT_REMINDER
  QUEST_DEADLINE
  STREAK_WARNING
  LEVEL_UP
  ACHIEVEMENT_UNLOCK
  LEVEL_REWARD_UNLOCK
  GOAL_MILESTONE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id                 String  @id @default(uuid())
  email              String  @unique
  username           String  @unique
  passwordHash       String
  avatar             String?
  hashedRefreshToken String?
  isAdmin            Boolean @default(false)

  level          Int       @default(1)
  totalXP        Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?

  /// The unlocked TITLE-type LevelReward currently displayed, if any. Must be
  /// one the user has actually unlocked (enforced in UsersService, not the DB).
  equippedTitleId              String?
  /// "Perks" (Sprint 3): one-time charge grant from a STREAK_PROTECTION
  /// LevelReward unlock, not an ongoing monthly refresh (no scheduler exists
  /// yet). Consumed by HabitsService.complete to preserve a habit's streak
  /// across a missed day instead of resetting it.
  habitStreakProtectionCharges Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills                 Skill[]
  attributes             Attribute[]
  goals                  Goal[]
  seasons                Season[]
  quests                 Quest[]
  habits                 Habit[]
  habitCompletions       HabitCompletion[]
  questCompletions       QuestCompletion[]
  challenges             Challenge[]
  xpTransactions         XPTransaction[]
  userAchievements       UserAchievement[]
  userLevelRewards       UserLevelReward[]
  notifications          Notification[]
  journalEntries         JournalEntry[]
  sentFriendRequests     Friendship[]      @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]      @relation("FriendshipAddressee")
  equippedTitle          LevelReward?      @relation("EquippedTitle", fields: [equippedTitleId], references: [id], onDelete: SetNull)

  @@map("users")
}

/// A friendship between two users, always stored as a single row regardless
/// of direction. Starts PENDING (created by the requester) and becomes
/// ACCEPTED once the addressee accepts - there is no DECLINED status, a
/// decline/cancel/unfriend is just deleting the row (see FriendsService).
/// The leaderboard's comparison group for a user is themselves plus every
/// user they have an ACCEPTED Friendship row with, in either direction.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // Only stops a duplicate row in the SAME direction - the service layer
  // additionally checks the reverse direction before creating a new request,
  // since A->B and B->A are logically the same relationship.
  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendships")
}

/// The 8 top-level character attributes (Physical, Intelligence, ...). Every
/// user gets all 8 auto-created at registration - unlike skills, attributes
/// are not opt-in. Attribute XP/level is derived by mirroring the XP a user
/// earns in any skill that belongs to it (see XpService.awardXp).
model Attribute {
  id          String       @id @default(uuid())
  userId      String
  key         AttributeKey
  name        String
  description String?
  icon        String?

  level   Int @default(1)
  totalXP Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            Skill[]
  xpTransactions    XPTransaction[]
  activityBonuses   ActivityAttributeBonus[]
  questRequirements QuestRequirement[]
  challenges        Challenge[]

  @@unique([userId, key])
  @@index([userId])
  @@map("attributes")
}

/// Bonus XP a quest/habit/goal awards directly to an attribute on completion,
/// independent of any tagged skill - e.g. a workout quest giving some
/// Discipline credit for showing up, on top of whatever Strength/Physical it
/// awards via tagged skills (see QuestSkill.amount and friends). Exactly one
/// of questId/habitId/goalId is set, matching whichever activity owns this
/// bonus line. Part of "XP Bundles" - see docs/gameplay-systems.md.
model ActivityAttributeBonus {
  id          String  @id @default(uuid())
  questId     String?
  habitId     String?
  goalId      String?
  attributeId String
  amount      Int

  quest     Quest?    @relation(fields: [questId], references: [id], onDelete: Cascade)
  habit     Habit?    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([questId, attributeId])
  @@unique([habitId, attributeId])
  @@unique([goalId, attributeId])
  @@index([questId])
  @@index([habitId])
  @@index([goalId])
  @@index([attributeId])
  @@map("activity_attribute_bonuses")
}

model Skill {
  id          String  @id @default(uuid())
  userId      String
  attributeId String
  name        String
  description String?
  icon        String?
  isDefault   Boolean @default(false)

  level   Int @default(1)
  totalXP Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  questSkills       QuestSkill[]
  habitSkills       HabitSkill[]
  goalSkills        GoalSkill[]
  xpTransactions    XPTransaction[]
  questRequirements QuestRequirement[]
  challenges        Challenge[]

  // Same skill name can exist under different attributes (e.g. "Focus" under
  // both Intelligence and Discipline) as distinct stats, so uniqueness is
  // scoped per-attribute rather than globally per-user.
  @@unique([userId, attributeId, name])
  @@index([userId])
  @@index([attributeId])
  @@map("skills")
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  /// Optional season this goal belongs to ("Seasons and Chapters", Sprint 5) -
  /// organizational only, mirroring how Quest/Habit link to a Goal. A season
  /// closing does not touch its linked goals' own status.
  seasonId    String?
  title       String
  description String?
  category    String?
  type        GoalType   @default(BINARY)
  status      GoalStatus @default(ACTIVE)

  targetValue  Float?
  currentValue Float   @default(0)
  unit         String?

  xpReward Int @default(500)

  startDate   DateTime  @default(now())
  targetDate  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season            Season?                  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  quests            Quest[]
  /// Habits linked to this goal - organizational only, matching Quest.goalId's
  /// shape. Deliberately NOT counted toward a COMPLETION-type goal's progress
  /// (see GoalsService.syncCompletionProgress's doc comment for why) - a
  /// habit has no discrete "done" state the way a quest does, so it doesn't
  /// fit the same counting model.
  habits            Habit[]
  goalSkills        GoalSkill[]
  attributeBonuses  ActivityAttributeBonus[]
  questRequirements QuestRequirement[]       @relation("RequiredByGoal")
  milestones        GoalMilestone[]

  @@index([userId])
  @@map("goals")
}

model GoalSkill {
  id      String @id @default(uuid())
  goalId  String
  skillId String
  /// Overrides the goal's flat xpReward for this specific skill (and its
  /// attribute cascade) on completion. Null means "use the goal's xpReward",
  /// matching behavior before XP Bundles (see ActivityAttributeBonus) existed.
  amount  Int?

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([goalId, skillId])
  @@map("goal_skills")
}

/// "Goal milestones" (Sprint 4): an ordered checklist item within a goal,
/// distinct from Quest/Habit - lighter-weight than creating a whole quest for
/// a simple checkpoint (e.g. "Reach 100kg on deadlift" inside a "Get Stronger"
/// goal). Optionally carries its own small XP reward, separate from the
/// goal's own completion reward - see GoalsService for the award rules.
model GoalMilestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?
  /// Display order within the goal - not a Prisma-enforced uniqueness, just a sort key set by the client.
  order       Int
  xpReward    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_milestones")
}

/// "Seasons and Chapters" (Sprint 5): divides a user's progression into
/// named chapters with a focus (1+ attributes) and a date range, instead of
/// one endless timeline. At most one ACTIVE season per user at a time -
/// enforced in SeasonsService, not the database. startAttributeLevels is a
/// snapshot of every attribute's level at creation time ({ [AttributeKey]:
/// number }), so a closed season's deltas stay fixed forever even as the
/// user keeps leveling; an ACTIVE season's deltas are instead computed live
/// against the user's *current* attribute levels (see SeasonsService).
model Season {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String?
  focus       AttributeKey[]

  startDate DateTime     @default(now())
  endDate   DateTime?
  status    SeasonStatus @default(ACTIVE)

  startLevel           Int
  startAttributeLevels Json

  closedAt           DateTime?
  endLevel           Int?
  endAttributeLevels Json?

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]

  @@index([userId])
  @@index([userId, status])
  @@map("seasons")
}

model Quest {
  id          String  @id @default(uuid())
  userId      String
  goalId      String?
  title       String
  description String?

  type       QuestType       @default(ONE_TIME)
  difficulty QuestDifficulty @default(MEDIUM)
  status     QuestStatus     @default(ACTIVE)
  /// "Quest Board" grouping. Every quest gets a real category (no null/"uncategorized"
  /// state) - existing quests were backfilled to LONG_TERM. SYSTEM quests are
  /// auto-generated by QuestsService, not user-created, though nothing stops a
  /// user from picking SYSTEM manually too.
  category   QuestCategory   @default(LONG_TERM)

  xpReward        Int
  deadline        DateTime?
  completedAt     DateTime?
  lastCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?                    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  questSkills      QuestSkill[]
  attributeBonuses ActivityAttributeBonus[]
  requirements     QuestRequirement[]       @relation("QuestOwnRequirements")
  requiredByQuests QuestRequirement[]       @relation("RequiredByQuest")
  completions      QuestCompletion[]

  @@index([userId])
  @@index([goalId])
  @@index([userId, category])
  @@map("quests")
}

/// A single prerequisite a quest must satisfy before it can be completed
/// ("level-gated quests"). Five types, reusing a shared set of nullable
/// columns across them (mirrors how Achievement reuses skillName/attributeKey
/// across its requirement types) rather than one table per type. A locked
/// quest (unmet requirements) is never hidden - QuestsService computes
/// isLocked/requirements at read time; this model only stores the conditions,
/// not any derived locked/unlocked state.
model QuestRequirement {
  id      String               @id @default(uuid())
  questId String
  type    QuestRequirementType

  /// LEVEL_THRESHOLD: skillId+attributeId both null = character level;
  /// skillId set = that skill's level; attributeId set = that attribute's
  /// level. ACTIVITY_COUNT: skillId required - count of completed activities
  /// tagged with that skill (same query shape as
  /// AchievementsService's SKILL_ACTIVITY_COUNT case).
  skillId     String?
  attributeId String?
  /// LEVEL_THRESHOLD target level.
  level       Int?
  /// ACTIVITY_COUNT target count.
  count       Int?

  /// ACHIEVEMENT: the specific achievement that must be unlocked.
  achievementId   String?
  /// QUEST_COMPLETED: a specific other quest that must be completed - not
  /// "any quest".
  requiredQuestId String?
  /// GOAL_COMPLETED: a specific goal that must be completed - not "any goal",
  /// mirroring QUEST_COMPLETED's specificity (more composable than a vague
  /// "complete something").
  requiredGoalId  String?

  quest         Quest        @relation("QuestOwnRequirements", fields: [questId], references: [id], onDelete: Cascade)
  skill         Skill?       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attribute     Attribute?   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  achievement   Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  requiredQuest Quest?       @relation("RequiredByQuest", fields: [requiredQuestId], references: [id], onDelete: Cascade)
  requiredGoal  Goal?        @relation("RequiredByGoal", fields: [requiredGoalId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@index([skillId])
  @@index([attributeId])
  @@index([achievementId])
  @@index([requiredQuestId])
  @@index([requiredGoalId])
  @@map("quest_requirements")
}

/// One record per quest completion (not per quest - a RECURRING quest
/// completes many times, each independently claimable). Completing a quest
/// creates this row but does NOT award XP; a separate claim step
/// (QuestsService.claimReward) does, matching the roadmap's
/// COMPLETED -> REWARD CLAIMED state. Deliberately does not snapshot the
/// reward: claiming re-reads the quest's *current* xpReward/tagged
/// skills/XP Bundle config, same as complete() always has - editing a
/// quest's reward between completing and claiming it changes what's paid
/// out (see docs/gameplay-systems.md for the tradeoff).
model QuestCompletion {
  id        String @id @default(uuid())
  questId   String
  userId    String
  /// "once" for ONE_TIME/DEADLINE/MILESTONE quests; a day-key (getDayKey())
  /// for RECURRING quests - same per-period dedup mechanism HabitCompletion
  /// already uses via its own periodKey.
  periodKey String

  completedAt DateTime  @default(now())
  /// Null = reward not yet claimed.
  claimedAt   DateTime?

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, periodKey])
  @@index([userId])
  @@index([questId])
  @@map("quest_completions")
}

/// A time-boxed, system-generated objective ("Daily and Weekly Challenges" -
/// Feature 3), distinct from a Quest: entirely auto-generated (no manual
/// create/edit endpoints), targets whichever attribute the user has most
/// neglected recently (see findNeglectedAttribute in
/// backend/src/common/neglected-attribute.ts - shared with Quest Board's
/// System quests), and its progress is driven by a domain-event listener
/// rather than any Quest/Habit/Goal service knowing about it.
model Challenge {
  id          String          @id @default(uuid())
  userId      String
  type        ChallengeType
  title       String
  description String
  attributeId String
  /// One of the user's own skills under attributeId, if any existed when generated - DAILY challenges are phrased around it ("complete an activity tagged with X").
  skillId     String?
  /// WEEKLY: the XP threshold to reach in attributeId. DAILY: not a threshold - any qualifying completion finishes it immediately (see progressXp).
  targetXp    Int
  /// XP earned in attributeId since this challenge was generated, toward targetXp. A listener-updated running total, not re-derived per request.
  progressXp  Int             @default(0)
  /// Bonus XP awarded (character-level) when the challenge completes.
  xpReward    Int
  status      ChallengeStatus @default(ACTIVE)
  /// Day-key (DAILY) or Monday-anchored week-key (WEEKLY, see getWeekKey) - dedup key so at most one challenge of a type exists per period.
  periodKey   String
  completedAt DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  skill     Skill?    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodKey])
  @@index([userId])
  @@map("challenges")
}

model QuestSkill {
  id      String @id @default(uuid())
  questId String
  skillId String
  /// Overrides the quest's flat xpReward for this specific skill (and its
  /// attribute cascade) on completion. Null means "use the quest's xpReward",
  /// matching behavior before XP Bundles (see ActivityAttributeBonus) existed.
  amount  Int?

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([questId, skillId])
  @@map("quest_skills")
}

model Habit {
  id          String  @id @default(uuid())
  userId      String
  /// Optional goal this habit supports ("goal↔habit relationships", Sprint 4) -
  /// mirrors Quest.goalId exactly: organizational grouping only, shown on the
  /// goal detail page, never counted toward a COMPLETION-type goal's progress.
  goalId      String?
  title       String
  description String?

  frequency    HabitFrequency @default(DAILY)
  daysOfWeek   Int[]          @default([])
  timesPerWeek Int?
  timeOfDay    String?

  xpReward      Int     @default(10)
  isActive      Boolean @default(true)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?                    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  habitSkills      HabitSkill[]
  completions      HabitCompletion[]
  attributeBonuses ActivityAttributeBonus[]

  @@index([userId])
  @@map("habits")
}

model HabitSkill {
  id      String @id @default(uuid())
  habitId String
  skillId String
  /// Overrides the habit's flat xpReward for this specific skill (and its
  /// attribute cascade) on completion. Null means "use the habit's xpReward",
  /// matching behavior before XP Bundles (see ActivityAttributeBonus) existed.
  amount  Int?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([habitId, skillId])
  @@map("habit_skills")
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  userId      String
  periodKey   String
  completedAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, periodKey])
  @@index([userId])
  @@map("habit_completions")
}

model XPTransaction {
  id          String       @id @default(uuid())
  userId      String
  skillId     String?
  attributeId String?
  amount      Int
  sourceType  XPSourceType
  sourceId    String?
  /// The source entity's display name (e.g. a quest's title), captured at write
  /// time rather than resolved later by joining on sourceId - so a ledger row's
  /// label survives the source quest/habit/goal being renamed or deleted.
  sourceName  String?
  /// Correlates every row written by a single XpService.awardXp/applyCorrection
  /// call (the character row plus each skill/attribute mirror row it cascaded
  /// into), so AnalyticsService.xpHistory can group them back into one event.
  /// Deliberately NOT createdAt: Prisma's @default(now()) is evaluated
  /// per-statement (client-side), not per-transaction, so sibling rows from one
  /// call can differ by a few milliseconds - not a safe grouping key. Nullable
  /// because rows written before this column existed have no value to backfill.
  eventId     String?
  note        String?
  createdAt   DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill?     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attribute Attribute? @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skillId])
  @@index([attributeId])
  @@index([userId, createdAt])
  @@index([eventId])
  @@map("xp_transactions")
}

model Achievement {
  id               String                     @id @default(uuid())
  key              String                     @unique
  name             String
  description      String
  icon             String?
  requirementType  AchievementRequirementType
  requirementValue Int
  skillName        String?
  attributeKey     AttributeKey?

  createdAt DateTime @default(now())

  userAchievements  UserAchievement[]
  questRequirements QuestRequirement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

/// A globally-defined reward that unlocks at a level threshold ("Level-Up
/// Rewards" - Sprint 3 Feature 6). Data-driven like Achievement: seeded, not
/// user-created, evaluated by LevelRewardsService.checkAndUnlock against
/// current level state. Scoped to the character (attributeKey: null) or one
/// of the 8 fixed attributes - deliberately NOT per-skill, since skills are
/// user-created and a globally-seeded reward can't sensibly target one.
model LevelReward {
  id           String          @id @default(uuid())
  key          String          @unique
  name         String
  description  String
  icon         String?
  type         LevelRewardType
  attributeKey AttributeKey?
  /// Threshold level within this reward's scope (character level if attributeKey is null, that attribute's level otherwise).
  level        Int

  createdAt DateTime @default(now())

  userLevelRewards UserLevelReward[]
  equippedByUsers  User[]            @relation("EquippedTitle")

  @@map("level_rewards")
}

model UserLevelReward {
  id            String   @id @default(uuid())
  userId        String
  levelRewardId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelReward LevelReward @relation(fields: [levelRewardId], references: [id], onDelete: Cascade)

  @@unique([userId, levelRewardId])
  @@index([userId])
  @@map("user_level_rewards")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

/// "Daily Journal" / "Mood and Energy Tracking" (Sprint 6, Features 17-18): one row per user per
/// calendar day. `date` is a UTC day key (see common/period.ts's getDayKey), the same convention
/// `HabitCompletion.periodKey` already uses, rather than a DateTime - a journal entry is inherently
/// about a calendar day, not a timestamp. All tracked fields are optional so a user can log
/// whichever subset they want on a given day. "What was completed and XP earned that day" (per the
/// roadmap's own framing) is deliberately NOT stored here - it's computed live from XPTransaction
/// at read time by JournalService, the same "derived, not duplicated" approach used for
/// Goal.progressPercent and friends.
model JournalEntry {
  id          String  @id @default(uuid())
  userId      String
  date        String
  mood        Int?
  energyLevel Int?
  sleepHours  Float?
  stressLevel Int?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("journal_entries")
}
